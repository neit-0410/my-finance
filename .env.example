# Copy to .env.docker (not .env) for the full Docker workflow.
# If existing volumes were initialized with .env, copy .env to .env.docker instead
# and preserve the existing database names/password before adding JWT configuration.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-password
MYSQL_DATABASE=finance_db
MONGO_DB=finance_db
# Required: a random 32-byte or longer Base64 key, stable across container restarts.
FINANCE_JWT_SECRET=
FINANCE_JWT_EXPIRATION_MS=3600000
APP_PORT=8088
