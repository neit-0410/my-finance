{
  "info": {
    "name": "My Finance - Idempotency QA",
    "description": "Run the entire collection in order, one iteration. Creates two disposable QA accounts and financial data; does not delete data. baseUrl defaults to Docker http://localhost:8088. See docs/testing/idempotency-test-cases.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenA}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Setup - Register A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameA}}\",\n  \"email\": \"{{usernameA}}@example.com\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\");",
                  "pm.collectionVariables.set(\"run\", run);",
                  "pm.collectionVariables.set(\"usernameA\", \"qa_idem_a_\" + run);",
                  "pm.collectionVariables.set(\"usernameB\", \"qa_idem_b_\" + run);",
                  "pm.collectionVariables.set(\"password\", \"Qa-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "for (const key of [\"tokenA\", \"tokenB\", \"userAId\", \"userBId\", \"categoryId\", \"categoryBId\", \"categoryResponse\", \"cashResponse\", \"buyResponse\", \"priceResponse\", \"noKeyId\"]) pm.collectionVariables.unset(key);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"userAId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Login A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameA}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JWT returned\", () => pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"tokenA\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Register B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameB}}\",\n  \"email\": \"{{usernameB}}@example.com\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"userBId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Login B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameB}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JWT returned\", () => pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"tokenB\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Idempotency test cases (run in order)",
      "item": [
        {
          "name": "IDEM-01 First category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{run}}-category"
              }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Idempotency\",\n  \"type\": \"EXPENSE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Replay = false\", () => pm.expect(pm.response.headers.get(\"Idempotency-Replayed\")).to.eql(\"false\"));",
                  "pm.collectionVariables.set(\"categoryResponse\", pm.response.text());",
                  "pm.collectionVariables.set(\"categoryId\", pm.response.json().id);",
                  "pm.test(\"No password\", () => pm.expect(pm.response.text()).not.to.include(\"password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "IDEM-02 Replay category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{run}}-category"
              }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Idempotency\",\n  \"type\": \"EXPENSE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Exact response replay\", () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get(\"categoryResponse\")));",
                  "pm.test(\"Replay = true\", () => pm.expect(pm.response.headers.get(\"Idempotency-Replayed\")).to.eql(\"true\"));"
                ]
              }
            }
          ]
        },
