        {
          "name": "IDEM-29 Six concurrent cash requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/transactions/user/{{userAId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const base = pm.variables.get(\"baseUrl\");",
                  "const token = pm.collectionVariables.get(\"tokenA\");",
                  "const body = JSON.stringify({ amount: 20, type: \"EXPENSE\", categoryId: Number(pm.collectionVariables.get(\"categoryId\")), transactionDate: \"2026-01-01\", description: \"QA concurrent\" });",
                  "const key = pm.collectionVariables.get(\"run\") + \"-parallel\";",
                  "let remaining = 6;",
                  "const responses = [];",
                  "for (let i = 0; i < 6; i++) {",
                  "  pm.sendRequest({ url: base + \"/api/transactions\", method: \"POST\", header: { \"Content-Type\": \"application/json\", Authorization: \"Bearer \" + token, \"Idempotency-Key\": key }, body: { mode: \"raw\", raw: body } }, (err, response) => {",
                  "    pm.test(\"Concurrent request \" + i + \" succeeds\", () => { pm.expect(err).to.equal(null); pm.expect(response.code).to.eql(200); });",
                  "    if (!err) responses.push(response);",
                  "    if (--remaining !== 0) return;",
                  "    pm.test(\"Only one execution; five replays\", () => {",
                  "      pm.expect(responses).to.have.lengthOf(6);",
                  "      pm.expect(responses.filter(r => r.headers.get(\"Idempotency-Replayed\") === \"false\")).to.have.lengthOf(1);",
                  "      pm.expect(responses.filter(r => r.headers.get(\"Idempotency-Replayed\") === \"true\")).to.have.lengthOf(5);",
                  "      pm.expect(new Set(responses.map(r => r.text())).size).to.eql(1);",
                  "    });",
                  "    pm.sendRequest({ url: base + \"/api/transactions/user/\" + pm.collectionVariables.get(\"userAId\"), method: \"GET\", header: { Authorization: \"Bearer \" + token } }, (readErr, readResponse) => {",
                  "      pm.test(\"Only two cash transactions in total\", () => { pm.expect(readErr).to.equal(null); pm.expect(readResponse.code).to.eql(200); pm.expect(readResponse.json()).to.have.lengthOf(2); });",
                  "    });",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
